{
	"name": "maptiles",
	"version": "1.0.0",
	"description": "A React component for rendering maps using PMTiles and MapLibre GL JS with OpenStreetMap support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./styles": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun run build:ts && bun run build:css",
		"build:ts": "tsc",
		"build:css": "bun run copy:css",
		"copy:css": "cp src/styles.css dist/styles.css",
		"dev": "bun run build --watch",
		"prepublishOnly": "bun run build",
		"typecheck": "tsc --noEmit",
		"save": "bash scripts/save.sh",
		"commit": "cz",
		"c": "cz",
		"commitlint": "commitlint",
		"changeset": "changeset",
		"cs": "changeset add",
		"changeset:add": "changeset add",
		"changeset:version": "changeset version",
		"changeset:status": "changeset status",
		"changeset:publish": "changeset publish",
		"prepare": "husky install || true"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"keywords": [
		"pmtiles",
		"maplibre",
		"map",
		"openstreetmap",
		"react",
		"typescript",
		"tiles",
		"vector-tiles"
	],
	"author": "",
	"license": "MIT",
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@protomaps/basemaps": "^5.7.0",
		"maplibre-gl": "^4.7.1",
		"pmtiles": "^3.1.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
